    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "stripe": "^22.4.0"
  }

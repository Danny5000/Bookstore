{
  "name": "pale-orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "vite dev",
    "build:web": "vite build",
    "build:services": "vite build --config vite.services.config.ts && vite build --config vite.services.config.ts --mode worker-health",
    "build": "npm run build:web && npm run build:services",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:raw": "tsx src/migrate.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "db:provision-roles:raw": "tsx src/provision-database-roles.ts",
    "db:provision-roles": "node --env-file-if-exists=.env --import tsx src/provision-database-roles.ts",
    "auth:schema": "npx --prefer-offline --yes auth@1.6.26 generate --config ./src/lib/server/auth/schema-config.ts --output ./src/lib/server/db/schema/auth.ts --yes && tsx scripts/normalize-auth-schema.ts",
    "auth:info": "npx --prefer-offline --yes auth@1.6.26 info --config ./src/lib/server/auth/schema-config.ts",
    "admin:bootstrap:raw": "tsx src/bootstrap-admin.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env --import tsx src/bootstrap-admin.ts",
    "worker:dev": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "worker:health": "node --env-file-if-exists=.env --import tsx src/worker-health.ts",
    "worker:watch": "node --watch --env-file-if-exists=.env --import tsx src/worker.ts",
    "storage:cleanup:raw": "tsx src/cleanup-storage.ts",
    "storage:cleanup": "node --env-file-if-exists=.env --import tsx src/cleanup-storage.ts",
    "storage:cleanup:apply": "node --env-file-if-exists=.env --import tsx src/cleanup-storage.ts --apply --writers-quiesced",
    "storage:migrate-volumes": "node --env-file-if-exists=.env --import tsx scripts/migrate-storage-volumes.ts",
    "storage:backup-volumes": "node --env-file-if-exists=.env --import tsx scripts/split-storage-backup.ts",
    "backup:bundle": "node --env-file-if-exists=.env --import tsx scripts/verify-deployment-backup-bundle.ts",
    "deployment:checkpoint": "node --env-file-if-exists=.env --import tsx scripts/deployment-checkpoint.ts",
    "stripe:preflight": "node scripts/stripe-secret-preflight.mjs",
    "smoke:plan6b": "node --import tsx scripts/plan6b-production-smoke.ts",
    "smoke:plan6b-fixture": "node --import tsx scripts/plan6b-fixture-runtime-probe.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:service": "vitest run --config vitest.service.config.ts",
    "test:integration:raw": "vitest run --config vitest.integration.config.ts",
    "test:integration": "tsx scripts/with-test-database.ts npm run test:integration:raw",
    "test:plan6b-upgrade": "tsx scripts/with-plan6b-upgrade-database.ts --phase-command tsx tests/integration/financial-migration.test.ts",
    "test:e2e:raw": "playwright test",
    "test:e2e": "tsx scripts/with-test-database.ts --worker --bootstrap-admin npm run test:e2e:raw",
    "test:e2e:headed:raw": "playwright test --headed",
    "test:e2e:headed": "tsx scripts/with-test-database.ts --worker --bootstrap-admin npm run test:e2e:headed:raw",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest --config vitest.config.ts",
    "test:database": "npm run test:integration && npm run test:e2e",
    "verify": "npm run check && npm run lint && npm run test:unit && npm run test:service && npm run test:database && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "@types/yauzl": "3.4.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "fflate": "0.8.3",
    "globals": "^17.9.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tsx": "4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.1",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.10.1",
    "file-type": "22.0.1",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "sharp": "0.35.3",
    "stripe": "^22.5.0",
    "yauzl": "3.4.0",
    "zod": "^4.4.3"
  }
}
